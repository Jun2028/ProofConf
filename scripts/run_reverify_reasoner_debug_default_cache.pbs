#!/bin/bash
#PBS -N rv_ds_r_dbg_def
#PBS -P CFP01-SF-009
#PBS -l walltime=00:45:00
#PBS -l select=1:ncpus=10:mpiprocs=1:ompthreads=10:mem=48gb
#PBS -j oe
#PBS -o logs/pbs/

set -euo pipefail

cd "$PBS_O_WORKDIR"
mkdir -p logs/pbs

if command -v module >/dev/null 2>&1; then
  module load git >/dev/null 2>&1 || true
fi

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export LEAN_NUM_THREADS=1
ulimit -n 65535 >/dev/null 2>&1 || true
export PROOFCONF_LEAN_JOBS="${PROOFCONF_LEAN_JOBS:-1}"
export PROOFCONF_LAKE_MAX_PROCS="${PROOFCONF_LAKE_MAX_PROCS:-4}"
export PROOFCONF_OUTPUT_ROOT="/scratch/${USER}/data/proofconf/output"
export PROOFCONF_LOGS_ROOT="${PROOFCONF_OUTPUT_ROOT}/logs"
export PROOFCONF_REVERIFY_ROOT="/scratch/${USER}/data/proofconf/reverify"
BASE_MINI_F2F="/scratch/${USER}/data/proofconf/miniF2F-lean4-main"
JOB_REVERIFY_ROOT="/scratch/${USER}/data/proofconf/reverify_work/${PBS_JOBID}"
export PROOFCONF_TMP_ROOT="${JOB_REVERIFY_ROOT}/tmp"
mkdir -p "$PROOFCONF_LOGS_ROOT" "$PROOFCONF_REVERIFY_ROOT" "$PROOFCONF_TMP_ROOT" "$JOB_REVERIFY_ROOT"
unset XDG_CACHE_HOME

if [ ! -d "$BASE_MINI_F2F" ]; then
  echo "ERROR: miniF2F root not found: $BASE_MINI_F2F" >&2
  exit 1
fi

cd "$BASE_MINI_F2F"
cat > "$PROOFCONF_TMP_ROOT/reverify_preflight.lean" <<'LEAN'
import Mathlib
theorem reverify_preflight : True := by
  trivial
LEAN
if ! timeout 90 lake env lean -E warning -j "$PROOFCONF_LEAN_JOBS" "$PROOFCONF_TMP_ROOT/reverify_preflight.lean"; then
  echo "WARN: preflight timed out/failed; continuing" >&2
fi

cd "$PBS_O_WORKDIR"
uv run python scripts/reverify_run.py \
  --run-path /scratch/${USER}/data/proofconf/output/runs/2026-02-15_043621Z_deepseek_reasoner_prescreen_l1_l3_32 \
  --run-id 2026-02-15_043621Z_deepseek_reasoner_prescreen_l1_l3_32_debug_default_cache \
  --model-label deepseek-reasoner \
  --mini-f2f-root "$BASE_MINI_F2F" \
  --lean-workers 8 \
  --lean-jobs "$PROOFCONF_LEAN_JOBS" \
  --lean-procs "$PROOFCONF_LAKE_MAX_PROCS" \
  --lean-batch-size 16 \
  --timeout-s 600 \
  --debug-errors \
  --output-json ${PROOFCONF_REVERIFY_ROOT}/2026-02-15_043621Z_deepseek_reasoner_prescreen_l1_l3_32.debug_default_cache.json \
  --output-md ${PROOFCONF_REVERIFY_ROOT}/2026-02-15_043621Z_deepseek_reasoner_prescreen_l1_l3_32.debug_default_cache.md
