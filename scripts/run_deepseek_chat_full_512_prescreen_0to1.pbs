#!/bin/bash
#PBS -N ds_chat_512_p0to1
#PBS -P CFP01-SF-009
#PBS -l walltime=07:30:00
#PBS -l select=1:ncpus=10:mpiprocs=1:ompthreads=10:mem=64gb
#PBS -j oe
#PBS -o logs/pbs/

set -euo pipefail

cd "$PBS_O_WORKDIR"
mkdir -p logs/pbs

if command -v module >/dev/null 2>&1; then
  module load git >/dev/null 2>&1 || true
fi

# Keep subprocess threading bounded.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export LEAN_NUM_THREADS=1
ulimit -n 65535 >/dev/null 2>&1 || true

# Verifier/runtime controls (validated stable for 8-way single-job runs).
export PROOFCONF_LEAN_JOBS="${PROOFCONF_LEAN_JOBS:-1}"
export PROOFCONF_LAKE_MAX_PROCS="${PROOFCONF_LAKE_MAX_PROCS:-8}"
export PROOFCONF_LAKE_LAUNCH_GAP_MS="${PROOFCONF_LAKE_LAUNCH_GAP_MS:-250}"
export PROOFCONF_DIRECT_LEAN="${PROOFCONF_DIRECT_LEAN:-1}"
export PROOFCONF_PRUNE_AESOP_IMPORT="${PROOFCONF_PRUNE_AESOP_IMPORT:-1}"
export PROOFCONF_KEEP_TMP="${PROOFCONF_KEEP_TMP:-0}"

# Scratch roots (avoid writing heavy artifacts in repo/home).
export PROOFCONF_OUTPUT_ROOT="/scratch/${USER}/data/proofconf/output"
export PROOFCONF_RUNS_ROOT="${PROOFCONF_OUTPUT_ROOT}/runs"
export PROOFCONF_LOGS_ROOT="${PROOFCONF_OUTPUT_ROOT}/logs"
export PROOFCONF_REVERIFY_ROOT="/scratch/${USER}/data/proofconf/reverify"
BASE_MINI_F2F="/scratch/${USER}/data/proofconf/miniF2F-lean4-main"
JOB_WORK_ROOT="/scratch/${USER}/data/proofconf/fullrun_work/${PBS_JOBID}"
export XDG_CACHE_HOME="/scratch/${USER}/data/proofconf/cache/${PBS_JOBID}"
export PROOFCONF_TMP_ROOT="${JOB_WORK_ROOT}/tmp"
mkdir -p "$XDG_CACHE_HOME" "$PROOFCONF_RUNS_ROOT" "$PROOFCONF_LOGS_ROOT" "$PROOFCONF_TMP_ROOT" "$JOB_WORK_ROOT"

if [ ! -d "$BASE_MINI_F2F" ]; then
  echo "ERROR: miniF2F root not found: $BASE_MINI_F2F" >&2
  exit 1
fi

# Lightweight preflight.
cd "$BASE_MINI_F2F"
cat > "$PROOFCONF_TMP_ROOT/preflight.lean" <<'LEAN'
import Mathlib
theorem proofconf_preflight : True := by
  trivial
LEAN
if ! timeout 120 lake env lean -E warning -j "$PROOFCONF_LEAN_JOBS" "$PROOFCONF_TMP_ROOT/preflight.lean"; then
  echo "WARN: preflight timed out/failed; continuing" >&2
fi

cd "$PBS_O_WORKDIR"
RUN_TAG="deepseek_chat_full_512_prescreen_0to1"
uv run python -m proofconf.pipeline.run_experiment \
  --config configs/deepseek_chat_full_512_prescreen_0to1.json \
  --tag "$RUN_TAG"

# Post-run hard check: ensure logprobs were collected for every sample.
python - <<'PY'
import json
from pathlib import Path

runs_root = Path('/scratch') / Path(__import__('os').environ['USER']) / 'data/proofconf/output/runs'
run_dirs = sorted([p for p in runs_root.iterdir() if p.is_dir() and p.name.endswith('_deepseek_chat_full_512_prescreen_0to1')], key=lambda p: p.stat().st_mtime)
if not run_dirs:
    raise SystemExit('No run directory found for deepseek_chat_full_512_prescreen_0to1')
run_dir = run_dirs[-1]

samples_path = run_dir / 'samples.jsonl'
if not samples_path.exists():
    raise SystemExit(f'Missing samples.jsonl: {samples_path}')

expected_total = 16 * 512
theorem_counts = {}
bad_token_rows = 0
total = 0
with samples_path.open('r', encoding='utf-8') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        row = json.loads(line)
        total += 1
        th = row['theorem_name']
        theorem_counts[th] = theorem_counts.get(th, 0) + 1
        if int(row.get('token_count', 0)) <= 0:
            bad_token_rows += 1

if total != expected_total:
    raise SystemExit(f'Sample count mismatch: got {total}, expected {expected_total}')
bad_theorems = sorted([th for th, c in theorem_counts.items() if c != 512])
if bad_theorems:
    raise SystemExit(f'Theorem sample-count mismatch for: {bad_theorems[:8]} (and {max(0, len(bad_theorems)-8)} more)')
if bad_token_rows > 0:
    raise SystemExit(f'Found {bad_token_rows} sample rows with token_count <= 0 (logprobs missing)')

summary = {
    'run_dir': str(run_dir),
    'sample_rows': total,
    'theorem_count': len(theorem_counts),
    'token_count_leq_zero_rows': bad_token_rows,
}
(run_dir / 'meta' / 'logprobs_validation.json').parent.mkdir(parents=True, exist_ok=True)
(run_dir / 'meta' / 'logprobs_validation.json').write_text(json.dumps(summary, indent=2), encoding='utf-8')
print('[logprobs_validation_ok]', json.dumps(summary))
PY
