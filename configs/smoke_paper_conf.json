{
  "dataset_json": "docs/miniF2F-DeepSeekChat-Prescreen-0to1.json",
  "difficulty_levels": ["Level 1", "Level 2", "Level 3"],
  "split": "valid",
  "theorem_offset": 0,
  "num_theorems": 1,
  "samples_per_theorem": 1,
  "window_size_tokens": 24,
  "window_stride_tokens": 6,
  "llm_parallel_requests": 1,
  "lean_parallel_workers": 1,
  "lean_batch_size": 1,
  "tail_tokens": 256,
  "token_confidence_method": "paper_topk",
  "token_confidence_topk": 20,
  "token_confidence_require_full_topk": false,
  "token_confidence_fallback_to_chosen": false,
  "probe_prefix_parts": false,
  "models": [
    {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "env_file": ".secrets/deepseek.env",
      "temperature": 0.7,
      "max_tokens": 8000,
      "top_logprobs": 20
    }
  ]
}
