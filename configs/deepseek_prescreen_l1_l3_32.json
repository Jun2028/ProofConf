{
  "dataset_json": "docs/miniF2F-Graded.json",
  "difficulty_levels": ["Level 1", "Level 2", "Level 3"],
  "split": "valid",
  "theorem_offset": 0,
  "num_theorems": 195,
  "samples_per_theorem": 32,
  "window_size_tokens": 24,
  "window_stride_tokens": 6,
  "llm_parallel_requests": 8,
  "lean_parallel_workers": 8,
  "lean_batch_size": 16,
  "tail_tokens": 256,
  "probe_prefix_parts": false,
  "prefix_probe_quantiles": [0.33, 0.66],
  "prefix_probe_timeout_s": 10,
  "filter_top_percents": [10, 25, 50],
  "models": [
    {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "env_file": ".secrets/deepseek.env",
      "temperature": 0.7,
      "max_tokens": 8000,
      "top_logprobs": 20
    }
  ]
}
